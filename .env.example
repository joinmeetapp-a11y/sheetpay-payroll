# ─── Gemini AI (existing) ────────────────────────────────────────────────────
# Required for Cayla AI enhancement via the Express /api/cayla endpoint.
# AI Studio automatically injects this from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# The URL where this app is hosted (Cloud Run service URL).
APP_URL="MY_APP_URL"

# ─── Convex (backend database) ───────────────────────────────────────────────
# Get this after running: npx convex dev  (copy from the printed CONVEX_URL)
# IMPORTANT: for a PRODUCTION build this MUST be your CLOUD deployment URL
# (e.g. https://<name>.convex.cloud), NOT http://127.0.0.1:3210. Building with the
# local URL is what makes checkout / Cayla fail once the site is deployed.
VITE_CONVEX_URL="https://your-deployment.convex.cloud"

# ─── Paddle (billing / checkout) ─────────────────────────────────────────────
# Client-side token from Paddle dashboard → Developer Tools → Authentication →
# Client-side tokens (starts with live_ for production, test_ for sandbox).
# Powers the Paddle.js overlay checkout used by the pricing / upgrade buttons.
VITE_PADDLE_CLIENT_TOKEN="live_xxxxxxxxxxxxxxxxxxxxxxxx"
# "production" (default) or "sandbox".
VITE_PADDLE_ENVIRONMENT="production"

# The Convex project ID — used in auth.config.ts to verify Firebase tokens.
# Set this with: npx convex env set FIREBASE_PROJECT_ID your-project-id
FIREBASE_PROJECT_ID="your-firebase-project-id"

# ─── Firebase (auth + hosting) ───────────────────────────────────────────────
# Copy these from Firebase Console → Project Settings → Your Apps → Web App config.
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:000000000000000000000000"
