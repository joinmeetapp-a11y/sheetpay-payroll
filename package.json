{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:frontend": "vite build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy",
    "firebase:deploy": "firebase deploy --only hosting",
    "deploy": "npm run build:frontend && firebase deploy --only hosting",
    "test:bulk": "vitest run tests/bulkPayslipEmail.test.ts",
    "test:pricing": "vitest run tests/accountantPricing.test.ts",
    "test:mia": "vitest run tests/mia.test.ts",
    "test:social": "vitest run tests/social.test.ts",
    "check:convex": "tsc --noEmit --project tsconfig.pricing.json",
    "check:social-bundle": "node scripts/check-social-bundle.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "convex": "^1.44.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "fontkit": "2.0.4",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.5.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "resend": "^6.22.0",
    "satori": "0.35.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fontkit": "2.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "convex-test": "^0.0.60",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.3"
  }
}
